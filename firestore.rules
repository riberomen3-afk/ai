rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && 
        incoming().uid == userId &&
        incoming().email is string;
    }

    // Teams collection
    match /users/{userId}/teams/{teamId} {
      function isValidTeam(data) {
        return data.id is string &&
               data.name is string && data.name.size() <= 100 &&
               data.pokemon is list && data.pokemon.size() <= 6 &&
               data.ownerId == request.auth.uid;
      }

      allow list, get: if isOwner(userId);
      
      allow create: if isOwner(userId) && 
                      isValidId(teamId) && 
                      isValidTeam(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isOwner(userId) && 
                      isValidTeam(incoming()) &&
                      incoming().updatedAt == request.time &&
                      incoming().ownerId == existing().ownerId &&
                      incoming().createdAt == existing().createdAt;
      
      allow delete: if isOwner(userId);
    }
  }
}
